FROM node:20-alpine AS build
WORKDIR /app
COPY WebClient/package*.json ./
RUN npm ci --legacy-peer-deps
COPY WebClient ./
ARG REACT_APP_API_URL=http://localhost:8000
ARG REACT_APP_ZITADEL_AUTHORITY
ARG REACT_APP_ZITADEL_CLIENT_ID
ARG REACT_APP_ZITADEL_PROJECT_ID
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_ZITADEL_AUTHORITY=$REACT_APP_ZITADEL_AUTHORITY
ENV REACT_APP_ZITADEL_CLIENT_ID=$REACT_APP_ZITADEL_CLIENT_ID
ENV REACT_APP_ZITADEL_PROJECT_ID=$REACT_APP_ZITADEL_PROJECT_ID
RUN npm run build
FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY WebClient/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
