# Chat models (server-only secrets)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
UNSTOPPABLE_LLM_URL=https://your-username--totalai-llm-llmserver-serve.modal.run
UNSTOPPABLE_LLM_API_KEY=
UNSTOPPABLE_MAX_TOKENS=2048
UNSTOPPABLE_TIMEOUT_SECONDS=300
UNSTOPPABLE_HISTORY_MAX_CHARS=32000

# ZITADEL SPA and API applications
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_PROJECT_ID=
ZITADEL_FRONTEND_CLIENT_ID=
ZITADEL_INTROSPECTION_CLIENT_ID=
ZITADEL_INTROSPECTION_CLIENT_SECRET=
# Usually the ZITADEL project ID requested by the frontend audience scope.
ZITADEL_AUDIENCE=

# Stripe: the Price must be an active recurring USD $20/month Price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=price_

# Local PostgreSQL container
POSTGRES_PASSWORD=change-this-local-password
# One-time local migration only. Disable before exposing the app outside your machine.
LEGACY_IMPORT_ENABLED=true
LEGACY_OWNER_IDS=demo-user,local-user

# GPU image generation
DIFFUSERS_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
CONTROLNET_MODEL_ID=lllyasviel/control_v11p_sd15_openpose
IMAGE_GENERATION_SIZE=512
CHARACTER_VIEW_WIDTH=512
CHARACTER_VIEW_HEIGHT=768
SCENE_IMAGE_WIDTH=768
SCENE_IMAGE_HEIGHT=512
IMAGE_INFERENCE_STEPS=18
MINIMUM_FREE_VRAM_MIB=1800
HF_TOKEN=
PEOPLEWELCOME_ADMIN_EMAILS=
